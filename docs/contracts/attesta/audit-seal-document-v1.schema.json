{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trackai.dev/attesta/audit-seal/v1/audit-seal-document-v1.schema.json",
  "title": "TrackAI audit seal document v1",
  "description": "FROZEN CONTRACT (Task16e, A16.4). The document an audit_seal statement's subject digest names (RFC 8785 bytes). Rules: audit-seal.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tenant_id",
    "window",
    "previous",
    "catalog_version",
    "count",
    "rows",
    "rows_root"
  ],
  "properties": {
    "format": {
      "const": "https://trackai.dev/attesta/audit-seal-document/v1"
    },
    "tenant_id": {
      "$ref": "#/definitions/uuid"
    },
    "window": {
      "$ref": "#/definitions/window"
    },
    "previous": {
      "oneOf": [
        {
          "$ref": "#/definitions/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "catalog_version": {
      "$ref": "#/definitions/catalog_version"
    },
    "count": {
      "$ref": "#/definitions/count"
    },
    "rows": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/uuid"
          },
          "digest": {
            "$ref": "#/definitions/digest"
          }
        }
      }
    },
    "rows_root": {
      "$ref": "#/definitions/digest"
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "micro_timestamp": {
      "type": "string",
      "pattern": "^(19|20|21)[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "The exact occurred_at text of the audit read API: RFC 3339 UTC with six fractional digits."
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "description": "Half-open [from, to), compared with occurred_at; from < to.",
      "properties": {
        "from": {
          "$ref": "#/definitions/micro_timestamp"
        },
        "to": {
          "$ref": "#/definitions/micro_timestamp"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50000
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
