{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trackai.dev/attesta/security-findings-seal/v1/security-findings-seal-document-v1.schema.json",
  "title": "TrackAI security-findings seal document v1",
  "description": "FROZEN CONTRACT when merged (Task15op, A15.15). The document a security_findings_seal statement subject digest names (RFC 8785 bytes). Rules: security-findings-seal.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tenant_id",
    "window",
    "previous",
    "count",
    "generations",
    "rows",
    "rows_root"
  ],
  "properties": {
    "format": {
      "const": "https://trackai.dev/attesta/security-findings-seal-document/v1"
    },
    "tenant_id": {
      "$ref": "#/definitions/uuid"
    },
    "window": {
      "$ref": "#/definitions/window"
    },
    "previous": {
      "oneOf": [
        {
          "$ref": "#/definitions/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "$ref": "#/definitions/count"
    },
    "generations": {
      "$ref": "#/definitions/generations"
    },
    "rows": {
      "type": "array",
      "maxItems": 8000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/uuid"
          },
          "digest": {
            "$ref": "#/definitions/digest"
          }
        }
      }
    },
    "rows_root": {
      "$ref": "#/definitions/digest"
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "micro_timestamp": {
      "type": "string",
      "pattern": "^(19|20|21)[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "The exact received_at text: RFC 3339 UTC with six fractional digits."
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "description": "Half-open [from, to), compared with received_at; from < to.",
      "properties": {
        "from": {
          "$ref": "#/definitions/micro_timestamp"
        },
        "to": {
          "$ref": "#/definitions/micro_timestamp"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8000
    },
    "generations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task6a",
        "v2"
      ],
      "description": "Row counts per record_generation; their sum is count.",
      "properties": {
        "task6a": {
          "$ref": "#/definitions/count"
        },
        "v2": {
          "$ref": "#/definitions/count"
        }
      }
    }
  }
}
