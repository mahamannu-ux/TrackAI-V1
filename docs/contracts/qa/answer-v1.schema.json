{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trackai.dev/contracts/qa/answer-v1.schema.json",
  "title": "TrackAI Q&A answer envelope v1",
  "description": "One answer to one registered question (docs/contracts/qa/README.md). Frozen: additive changes only. Integers only; an unavailable figure has value null, never 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "registry_version",
    "kind",
    "as_of",
    "scope",
    "availability",
    "reasons",
    "figures",
    "wording",
    "drilldown"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^(Q|S)[1-9][0-9]{0,2}$"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "live",
        "verifiable",
        "signed"
      ]
    },
    "as_of": {
      "$ref": "#/definitions/time"
    },
    "scope": {
      "$ref": "#/definitions/scope"
    },
    "availability": {
      "$ref": "#/definitions/availability"
    },
    "reasons": {
      "$ref": "#/definitions/reasons"
    },
    "figures": {
      "$ref": "#/definitions/figures"
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "figures"
      ],
      "properties": {
        "from": {
          "$ref": "#/definitions/time"
        },
        "to": {
          "$ref": "#/definitions/time"
        },
        "figures": {
          "$ref": "#/definitions/figures"
        }
      }
    },
    "wording": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": {
        "type": "string",
        "enum": [
          "monitor_only_observed",
          "unknown_model_explicit",
          "merged_not_deployed_proxy",
          "churned_unavailable",
          "session_link_partial",
          "requested_not_confirmed",
          "metadata_only"
        ]
      }
    },
    "drilldown": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/drilldown_item"
      }
    },
    "signed_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "query"
      ],
      "properties": {
        "path": {
          "const": "/api/attesta/statements"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "repository_id": {
              "$ref": "#/definitions/uuid"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z_]{1,40}$"
            },
            "subject_sha": {
              "$ref": "#/definitions/commit_sha"
            },
            "from": {
              "$ref": "#/definitions/time"
            },
            "to": {
              "$ref": "#/definitions/time"
            }
          }
        }
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_digest",
        "predicate_type"
      ],
      "properties": {
        "statement_digest": {
          "$ref": "#/definitions/digest"
        },
        "predicate_type": {
          "type": "string",
          "pattern": "^https://trackai\\.dev/attesta/[a-z0-9-]+/v[0-9]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "live"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "signed"
          ]
        },
        "properties": {
          "figures": {
            "type": "array",
            "items": {
              "not": {
                "required": [
                  "evidence"
                ]
              }
            }
          },
          "previous": {
            "properties": {
              "figures": {
                "type": "array",
                "items": {
                  "not": {
                    "required": [
                      "evidence"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verifiable"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "signed"
              ]
            }
          },
          {
            "not": {
              "required": [
                "signed_evidence"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "signed"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "signed_evidence"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "availability"
        ],
        "properties": {
          "kind": {
            "const": "signed"
          },
          "availability": {
            "enum": [
              "recorded",
              "partial"
            ]
          }
        }
      },
      "then": {
        "required": [
          "signed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "figures": {
            "type": "array",
            "items": {
              "properties": {
                "availability": {
                  "const": "unavailable"
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "availability": {
      "type": "string",
      "enum": [
        "recorded",
        "partial",
        "unavailable"
      ]
    },
    "gap": {
      "type": "string",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9",
        "G10",
        "G11",
        "G12",
        "G13"
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_captured_yet",
            "not_monitored",
            "vendor_does_not_report",
            "never_written",
            "partial_linkage",
            "answer_not_built",
            "phase_2"
          ]
        },
        "gap": {
          "$ref": "#/definitions/gap"
        }
      },
      "if": {
        "properties": {
          "code": {
            "const": "not_captured_yet"
          }
        }
      },
      "then": {
        "required": [
          "gap"
        ]
      },
      "else": {
        "not": {
          "required": [
            "gap"
          ]
        }
      }
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/reason"
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "count"
          ],
          "properties": {
            "type": {
              "const": "count"
            },
            "count": {
              "$ref": "#/definitions/non_negative_integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "numerator",
            "denominator"
          ],
          "properties": {
            "type": {
              "const": "ratio"
            },
            "numerator": {
              "$ref": "#/definitions/non_negative_integer"
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "ms"
          ],
          "properties": {
            "type": {
              "const": "duration_ms"
            },
            "ms": {
              "$ref": "#/definitions/non_negative_integer"
            }
          }
        }
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "model",
        "tool",
        "repository",
        "agent_family",
        "operating_system",
        "rule",
        "rule_category",
        "severity",
        "machine",
        "team"
      ]
    },
    "breakdown_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "key",
        "value"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/definitions/dimension"
        },
        "key": {
          "type": "string",
          "pattern": "^[^\\n\\r\\t]{1,200}$"
        },
        "value": {
          "$ref": "#/definitions/value"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "statements_root",
        "records"
      ],
      "properties": {
        "count": {
          "$ref": "#/definitions/non_negative_integer"
        },
        "statements_root": {
          "$ref": "#/definitions/digest"
        },
        "records": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "digest"
            ],
            "properties": {
              "seq": {
                "$ref": "#/definitions/non_negative_integer"
              },
              "digest": {
                "$ref": "#/definitions/digest"
              }
            }
          }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "availability",
        "reasons",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "availability": {
          "$ref": "#/definitions/availability"
        },
        "reasons": {
          "$ref": "#/definitions/reasons"
        },
        "value": {},
        "breakdown": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/definitions/breakdown_item"
          }
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      },
      "if": {
        "properties": {
          "availability": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "breakdown": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "$ref": "#/definitions/value"
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/figure"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "repository_id": {
          "$ref": "#/definitions/uuid"
        },
        "pull_request_id": {
          "$ref": "#/definitions/uuid"
        },
        "commit_sha": {
          "$ref": "#/definitions/commit_sha"
        },
        "from": {
          "$ref": "#/definitions/time"
        },
        "to": {
          "$ref": "#/definitions/time"
        }
      }
    },
    "drilldown_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "id",
        "label"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "repository",
            "pull_request",
            "commit",
            "file",
            "session",
            "finding",
            "statement"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._-]{1,128}$"
        },
        "label": {
          "type": "string",
          "pattern": "^[^/\\\\@\\n\\r\\t]{1,120}$"
        }
      }
    }
  }
}
